DATABASE_URL=postgres://origami:origami@localhost:5432/origami
ORIGAMI_SESSION_SECRET=change-me-to-a-long-random-secret-32ch
ORIGAMI_USER=admin
ORIGAMI_PASSWORD=origami
# ORIGAMI_PASSWORD_HASH=
# Default vault folder (inside the process). Override in Settings → System.
ORIGAMI_VAULT_DIR_DEFAULT=./data/vault
# Host path bind-mounted as that default (docker compose). Defaults to ./data/vault.
# ORIGAMI_VAULT_HOST=./data/vault
ORIGAMI_BACKUP_DIR=./data/backups
# Host path bind-mounted for scheduled project backups (docker compose). Defaults to ./data/backups.
# ORIGAMI_BACKUP_HOST=./data/backups
ORIGAMI_LOG_DIR=./logs
# Host path bind-mounted for application logs (docker compose). Defaults to ./logs.
# ORIGAMI_LOG_HOST=./logs
ORIGAMI_MAX_UPLOAD_MB=10240
# How often to scan vault and backup folders for files added or removed
# outside the app. Set to 0 to disable the periodic timer. Default 60000 (60s).
# Scans also run immediately on startup and before each backup pass.
# ORIGAMI_VAULT_SCAN_MS=60000
# Timezone for backup filenames (2026-08-25@15-26-02). Docker Compose default is Europe/London.
# TZ=Europe/London
